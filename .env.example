USE_MOCK=1

# Foundry project (azure-ai-projects SDK)
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_API_VERSION=2025-05-15-preview

# Azure OpenAI deployments inside the Foundry project
AZURE_OPENAI_ENDPOINT=https://<aoai>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
AZURE_OPENAI_MULTIMODAL_DEPLOYMENT=gpt-4o

# Foundry Tools
AZURE_SEARCH_ENDPOINT=https://<search>.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=docs-index

AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://<cu>.cognitiveservices.azure.com/
AZURE_CONTENT_UNDERSTANDING_KEY=

AZURE_CONTENT_SAFETY_ENDPOINT=https://<cs>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=

AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
