# Copy this file to `.env` and fill in the two values.
# `.env` is gitignored — do not commit real values.

# Full Foundry project endpoint, including the `/api/projects/<project>` path.
# Find it in the Foundry portal → your project → Overview → Project details.
FOUNDRY_PROJECT_ENDPOINT="https://<your-project>.services.ai.azure.com/api/projects/<your-project>"

# The DEPLOYMENT NAME you chose when deploying the chat model — not the
# model id. Example: "gpt-4o-mini-prod", not "gpt-4o-mini".
AZURE_AI_MODEL_DEPLOYMENT_NAME="<your-deployment-name>"
